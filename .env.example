# ========================================================
# AuraHealth Environment Configuration Template
# Duplicate this file to .env in your deployment or server directory:
#   cp .env.example server/.env
# DO NOT COMMIT ACTUAL .env FILES TO GITHUB!
# ========================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (SQLite for local demo; PostgreSQL for production)
# SQLite (Local):
DATABASE_URL="file:./dev.db"
# PostgreSQL (Production e.g. Neon, Supabase, Railway):
# DATABASE_URL="postgresql://username:password@hostname:5432/aurahealth?schema=public"

# Authentication Security (Generate a secure random string in production)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key_in_production"

# Allowed Frontend URL (CORS)
CLIENT_ORIGIN="http://localhost:3000"

# Optional External Notifications (Leave empty for demo logger)
EMAIL_PROVIDER_API_KEY=""
SMS_PROVIDER_API_KEY=""
