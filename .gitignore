# ========================================================
# AuraHealth Git Ignore Rules
# ========================================================

# 1. Environment and Sensitive Secrets (STRICTLY EXCLUDED)
.env
.env.*
!.env.example
*.env
server/.env
server/.env.*
client/.env
client/.env.*

# 2. Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 3. Production Build Outputs
dist/
*/dist/
build/
*/build/
out/
.next/

# 4. Databases & SQLite Files (Do not commit live database files)
*.db
*.db-journal
*.sqlite
*.sqlite3
dev.db
server/dev.db
server/prisma/dev.db
server/prisma/dev.db-journal

# 5. OS and File System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 6. IDEs & Editor Configuration
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 7. Testing & Coverage
coverage/
*/coverage/
.vitest/

# 8. Temporary and Log Files
*.log
logs/
*.tmp
*.temp
.system_generated/
